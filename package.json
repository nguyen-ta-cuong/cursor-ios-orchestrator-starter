{
  "name": "cursor-ios-orchestrator-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tools/orchestrator/test/*.test.ts tools/ios-harness/*.test.ts",
    "check": "npm run typecheck && npm test",
    "orchestrator": "tsx tools/orchestrator/run.ts",
    "orchestrator:dry-run": "tsx tools/orchestrator/run.ts --dry-run --config tools/orchestrator/config.example.json",
    "orchestrator:live": "tsx tools/orchestrator/run.ts --live",
    "login": "tsx tools/orchestrator/run.ts --login",
    "models": "tsx tools/orchestrator/run.ts --models",
    "harness": "bash tools/ios-harness/check.sh",
    "harness:dry-run": "bash tools/ios-harness/check.sh --dry-run",
    "memory": "tsx tools/orchestrator/memory-cli.ts",
    "skills": "tsx tools/orchestrator/skills-cli.ts",
    "workflow": "tsx tools/orchestrator/workflow-cli.ts",
    "workflow:example": "tsx tools/orchestrator/workflow-cli.ts generate --config tools/orchestrator/workflow.example.json --allow-placeholders"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
